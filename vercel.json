{
  "buildCommand": "cd frontend_new && npm install && npm run build",
  "outputDirectory": "frontend_new/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://vidhanai-backend.onrender.com/api/:path*"
    },
    {
      "source": "/:(.*)",
      "destination": "/index.html"
    }
  ]
}
